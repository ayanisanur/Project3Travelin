@model List<ResultTourDto>

<!-- top Destination starts -->
<section class="trending pt-6 pb-0 bg-lgrey">
    <div class="container">
        <div class="list-results d-flex align-items-center justify-content-between">
            <div class="list-results-sort">
                <p class="m-0">
                    Showing @(((int)ViewBag.CurrentPage - 1) * (int)ViewBag.PageSize + 1)-@(Math.Min((int)ViewBag.CurrentPage * (int)ViewBag.PageSize, (int)ViewBag.TotalCount)) of @ViewBag.TotalCount results
                </p>
            </div>
            <div class="click-menu d-flex align-items-center justify-content-between">
                <div class="change-list f-active me-2"><a href="tour-list.html"><i class="fa fa-bars rounded"></i></a></div>
                <div class="change-grid me-2"><a href="tour-grid.html"><i class="fa fa-th rounded"></i></a></div>
                <div class="sortby d-flex align-items-center justify-content-between ml-2">
                    <select class="niceSelect">
                        <option value="1">Sort By</option>
                        <option value="2">Average rating</option>
                        <option value="3">Price: low to high</option>
                        <option value="4">Price: high to low</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="destination-list">
            @foreach (var item in Model)
            {
                <div class="trend-full bg-white rounded box-shadow overflow-hidden p-4 mb-4">
                    <div class="row">
                        <div class="col-lg-4 col-md-3">
                            <div class="trend-item2 rounded">
                                <a href="tour-single.html" style="background-image: url(@item.ImageUrl);"></a>
                                <div class="color-overlay"></div>
                            </div>
                        </div>
                        <div class="col-lg-5 col-md-6">
                            <div class="trend-content position-relative text-md-start text-center">
                                <small>@item.DayNight</small>
                                <h3 class="mb-1"><a href="tour-single.html">@item.Title</a></h3>
                                <h6 class="theme mb-0"><i class="icon-location-pin"></i> @item.Country</h6>
                                <p class="mt-4 mb-0">@item.Description <br><a href="#"><span class="theme"> Ücretsiz İptal</span></a></p>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-3">
                            <div class="trend-content text-md-end text-center">
                                <div class="rating">
                                    <span class="fa fa-star checked"></span>
                                    <span class="fa fa-star checked"></span>
                                    <span class="fa fa-star checked"></span>
                                    <span class="fa fa-star checked"></span>
                                    <span class="fa fa-star checked"></span>
                                </div>
                                <small>200 Reviews</small>
                                <div class="trend-price my-2">
                                    <span class="mb-0">Kişi Başı</span>
                                    <h3 class="mb-0">@item.Price TL</h3>
                                    <small>'den başlayan fiyatlarla</small>
                                </div>
                                <a href="tour-single.html" class="nir-btn">Detayları İncele</a>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @{
                int currentPage = ViewBag.CurrentPage;
                int totalPages = ViewBag.TotalPages;
            }

            @if (totalPages > 1)
            {
                <div class="tour-pagination d-flex align-items-center justify-content-center mt-4 mb-4">

                    <a href="@(currentPage <= 1 ? "#" : "?page=" + (currentPage - 1))"
                       class="tour-page-btn tour-page-arrow @(currentPage <= 1 ? "disabled" : "")">
                        <i class="fa fa-angle-left"></i>
                    </a>

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <a href="?page=@i" class="tour-page-btn @(i == currentPage ? "active" : "")">@i</a>
                    }

                    <a href="@(currentPage >= totalPages ? "#" : "?page=" + (currentPage + 1))"
                       class="tour-page-btn tour-page-arrow @(currentPage >= totalPages ? "disabled" : "")">
                        <i class="fa fa-angle-right"></i>
                    </a>

                </div>
            }
        </div>
    </div>
</section>
<!-- top Destination ends -->

<style>
    .tour-pagination {
        gap: 10px;
        flex-wrap: wrap;
    }

    .tour-page-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: #fff;
        color: #333;
        font-weight: 600;
        font-size: 15px;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
        border: 1px solid transparent;
        transition: all 0.3s ease;
        text-decoration: none;
    }

        .tour-page-btn:hover {
            background: var(--theme-color, #f49b00);
            color: #fff;
            box-shadow: 0 5px 15px rgba(255, 90, 60, 0.35);
            transform: translateY(-2px);
        }

        .tour-page-btn.active {
            background: var(--theme-color, #f49b00);
            color: #fff;
            box-shadow: 0 5px 15px rgba(255, 90, 60, 0.35);
        }

    .tour-page-arrow {
        background: transparent;
        box-shadow: none;
        border: 1px solid #e0e0e0;
        color: #666;
        font-size: 16px;
    }

        .tour-page-arrow:hover {
            border-color: var(--theme-color, #f49b00);
            background: var(--theme-color, #f49b00);
            color: #fff;
        }

        .tour-page-arrow.disabled {
            pointer-events: none;
            opacity: 0.35;
            box-shadow: none;
        }
</style>